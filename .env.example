# Copy to .env.local for local development. Never commit real values.

# --- Database (Neon via the Vercel Marketplace injects these on Vercel) ---
# Local: run `pnpm db:local` and use the PGlite URL below.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/postgres
# Direct (non-pooled) connection used for migrations. Optional locally.
DATABASE_URL_UNPOOLED=

# --- Auth ---
# Signs CMS session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=
# The CMS login. The admin account is created from these on the first sign-in;
# after that, change the password inside the CMS (Settings) and these are ignored.
ADMIN_EMAIL=danielajayi100@gmail.com
ADMIN_INITIAL_PASSWORD=

# --- Site ---
# Canonical origin for metadata, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://daniel-lotsu.vercel.app

# --- File storage (Vercel Blob; injected when a Blob store is connected) ---
BLOB_READ_WRITE_TOKEN=
